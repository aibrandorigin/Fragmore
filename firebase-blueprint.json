        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "subtitle": { "type": "string" },
        "gender": { "type": "string", "enum": ["men", "women", "unisex", "devotional", "discovery"] },
        "collection": { "type": "string" },
        "scentProfile": { "type": "string" },
        "description": { "type": "string" },
        "story": { "type": "string" },
        "notes": { "type": "object" },
