rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_.\\-:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 160 &&
             data.name is string && data.name.size() <= 300 &&
             data.slug is string && data.slug.size() <= 200 &&
             data.variants is list;
    }

    function isValidOrder(data) {
      return data.orderNumber is string && data.orderNumber.size() <= 128 &&
             data.items is list &&
             data.totalAmount is number &&
             data.totalAmount >= 0;
    }

    function isValidReview(data) {
      return (data.customerName is string || data.authorName is string) &&
             data.rating is number &&
             data.rating >= 1 &&
             data.rating <= 5 &&
             data.title is string;
    }

    // Core Storefront Collections
    match /products/{docId} {
      allow list: if true;
      allow get: if isValidId(docId);
      allow create, update: if isValidId(docId) && isValidProduct(incoming());
      allow delete: if isValidId(docId);
    }

    match /orders/{docId} {
      allow list: if true;
      allow get: if isValidId(docId);
      allow create, update: if isValidId(docId) && isValidOrder(incoming());
      allow delete: if isValidId(docId);
    }

    match /customers/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /reviews/{docId} {
      allow list: if true;
      allow get: if isValidId(docId);
      allow create, update: if isValidId(docId) && isValidReview(incoming());
      allow delete: if isValidId(docId);
    }

    match /coupons/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /influencers/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /abandoned_carts/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /cms_settings/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /cms/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /audit_logs/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /campaigns/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /returns_refunds/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /returns/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /back_in_stock/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /users/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    // Rewards, Smart Wallet, Loyalty & Gift Cards Collections
    match /rewards_program_config/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }

    match /customer_wallets/{docId} {
